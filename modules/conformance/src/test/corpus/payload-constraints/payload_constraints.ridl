package validation.payload

type Whole : integer
type Ranged : float [0.0..1.0]
type Unconstrained : float
type Decimal : float [0.0..1.0 step 0.1]
type Offset : float [-3.0..9.0 step 4.0]
type Extreme : integer [-9223372036854775808..9223372036854775807]

struct Inline {
  text : string [8..8]
  count : integer [1..3]
  ratio : float [0.0..1.0 step 0.1]
  data : bytes [2..4]
}

struct Keys {
  text : [string : Whole; 0..3]
  number : [integer : Whole; 0..3]
}

// These float shapes receive deliberately extreme constraints in the IR test.
type StepOnly : float
type Tiny : float
type Wide : float
type Large : float

struct FloatingKeys { entries : [float : Whole; 0..3] }
struct ByteKeys { entries : [bytes : Whole; 0..3] }
struct Pattern { text : string [3..3 match /ABC/] }

type Corrected : float [-0.006828..1000000.0 step 0.00000000029452]
type DenseOrigin : float [54221000.0..40000000000000000.0 step 3.0162]
type Underflow : float [0.0..1.0 step 0.]
type LargeNegative : float

type OverflowStep : float [0.0.. step .0]

type Subnormal : float [0.0..1.0 step 0.] = 0.

type Fine : float [0.0..1.0 step 0.0000001]

struct ExtremeInline {
  fine : float [0.0..1.0 step 0.]
  huge : float [0.0.. step .0]
}

type HalfLower : float [0.0..]
type HalfUpper : float [..0.0]

struct InlineRange {
  grid : float [10.0..100.0 step 1.0]
  rangeOnly : float [0.0..1.0]
}
